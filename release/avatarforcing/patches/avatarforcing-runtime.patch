+    @torch.inference_mode()
+    def decode_stream_block(
+        self,
+        s_r: torch.Tensor,
+        s_r_feats: list,
+        r_d_block: torch.Tensor,
+    ) -> torch.Tensor:
+        """Decode one completed latent block with the official 10-frame batches."""
+        B, total_frames = r_d_block.shape[:2]
+        block_size = self.num_frames_per_block
+        identity = s_r.unsqueeze(1)
+        expanded_feats = [
+            feature.repeat_interleave(block_size, dim=0)
+            for feature in s_r_feats
+        ]
+        decoded = []
+
+        for start in range(0, total_frames, block_size):
+            latent = r_d_block[:, start:start + block_size]
+            valid_frames = latent.shape[1]
+            if valid_frames < block_size:
+                latent = F.pad(
+                    latent,
+                    (0, 0, 0, block_size - valid_frames),
+                    mode='replicate',
+                )
+            image = self.decode_block(
+                r_d_block=latent,
+                s_r=identity,
+                s_r_feats_expanded=expanded_feats,
+                block_size=block_size,
+                B=B,
+            )
+            decoded.append(image[:valid_frames])
+
+        return torch.cat(decoded, dim=0)
